# Base URL del backend (sin trailing slash y SIN sufijo /api — src/api/client.ts ya arma
# cada request como `${BACKEND_URL}/api/...`; si aquí se agrega /api, las URLs quedan duplicadas
# como /api/api/... y todas las llamadas al backend fallan).
EXPO_PUBLIC_BACKEND_URL=https://api.paljale.mx

# Clave publicable de Stripe para el SDK nativo (@stripe/stripe-react-native).
# NUNCA la clave secreta (sk_...) aquí — esta es pública y va en el cliente.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Maps API key para Android — se configura en app.json bajo
# android.config.googleMaps.apiKey (no va en variables de entorno).
# GOOGLE_MAPS_API_KEY=

# Configuración EAS (solo para scripts de deploy, no se embebe en la app)
EAS_PROJECT_ID=
APPLE_TEAM_ID=

# No editar — se usa solo en desarrollo local con Expo Go
EXPO_PACKAGER_PROXY_URL=
EXPO_PACKAGER_HOSTNAME=
