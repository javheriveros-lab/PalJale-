# Pal Jale — Backend Environment Variables
# Copia este archivo a .env y rellena los valores reales.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=paljale

# Seguridad JWT
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_DAYS=30

# Admin inicial
ADMIN_EMAIL=admin@paljale.mx
ADMIN_PASSWORD=change-me-strong-password

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Secreto del webhook de Stripe Connect (endpoint /api/connect/webhook).
# Se crea aparte en el Dashboard de Stripe -> Developers -> Webhooks -> Add endpoint
# apuntando a https://tu-backend/api/connect/webhook y suscrito a "account.updated".
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Cifrado de datos bancarios de la plataforma (admin_bank.py)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_DATA_ENCRYPTION_KEY=...

# ImageKit (almacenamiento de imágenes — KYC, fotos de producto, checklists)
# Claves en el dashboard de ImageKit -> Developer options
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_id

# Frontend / CORS
FRONTEND_URL=https://paljale.mx

# Expo / Notificaciones push (opcional para notificaciones server-side)
EXPO_ACCESS_TOKEN=...

# Firebase Admin SDK (opcional para notificaciones push avanzadas)
GOOGLE_APPLICATION_CREDENTIALS=backend/firebase-admin-sdk.json
